# Copie para .env e substitua os valores antes de executar o Docker Compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=gere-uma-senha-forte
POSTGRES_DB=fbref_scraper

# Chave usada para scraping e operações de escrita da API.
API_KEY=gere-uma-chave-forte

# Opcional: habilita os endpoints de odds da Cloudbet.
CLOUDBET_API_KEY=
CORS_ORIGINS=http://localhost:5173

# Em produção (ex.: Railway), preencha:
#   DATABASE_URL -> URL do Postgres gerenciado da plataforma
#   REDIS_URL    -> redis://<host>:<porta>/0 do Redis gerenciado
#   CORS_ORIGINS -> https://gledson2012.github.io (URL do GitHub Pages)
#   API_KEY      -> mesma chave configurada no frontend/deploy
