# Copie para .env e substitua os valores antes de executar o Docker Compose.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=gere-uma-senha-forte
POSTGRES_DB=fbref_scraper

# Chave usada para scraping e operações de escrita da API.
API_KEY=gere-uma-chave-forte

# Opcional: habilita os endpoints de odds da Cloudbet.
CLOUDBET_API_KEY=
CORS_ORIGINS=http://localhost:5173
